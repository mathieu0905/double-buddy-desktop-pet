{
  "name": "double-buddy-desktop-pet",
  "version": "1.0.0",
  "private": true,
  "productName": "一起摸鱼",
  "description": "A cozy two-character desktop pet built from a personal photo.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:renderer": "esbuild src/pet-renderer.js --bundle --format=esm --platform=browser --outfile=public/pet-renderer.js",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "predev": "npm run build:renderer",
    "dev": "electron .",
    "preview": "node src/server.js",
    "smoke": "electron scripts/smoke.cjs",
    "prepackage:mac": "npm run build:renderer",
    "package:mac": "node scripts/package-mac.cjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "electron": "^37.2.3",
    "esbuild": "^0.28.1"
  }
}
